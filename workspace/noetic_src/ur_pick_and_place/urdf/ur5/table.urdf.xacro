<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="table">

  <!-- Properties -->
  <xacro:property name="table_height" value="0.8" />
  <xacro:property name="table_width" value="1.0" />
  <xacro:property name="table_depth" value="1.0" />
  <xacro:property name="leg_radius" value="0.02" />
  <xacro:property name="table_x" value="0.0" />
  <xacro:property name="table_y" value="0.0" />
  <xacro:property name="table_z" value="-0.81" /> <!-- Agar permukaan meja sejajar z=0 -->
  <xacro:property name="table_top_thickness" value="0.05" />
  <xacro:property name="M_PI" value="3.1415926535897931" />

  <!-- Macro to define a table leg -->
  <xacro:macro name="table_leg" params="name pos_x pos_y">
    <joint name="${name}_joint" type="fixed">
      <parent link="table_top_link" />
      <origin xyz="${pos_x} ${pos_y} ${table_z + table_height}" rpy="0 0 0" />
      <child link="${name}_link" />
    </joint>

    <link name="${name}_link">
      <inertial>
        <mass value="1.0" />
        <origin xyz="0 0 ${-table_height/2}" />
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.01" />
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 ${-table_height/2}" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${leg_radius}" length="${table_height}" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 ${-table_height/2}" rpy="0.0 0.0 0.0" />
        <geometry>
          <cylinder radius="${leg_radius}" length="${table_height}" />
        </geometry>
      </collision>
    </link>

    <gazebo reference="${name}_link">
      <material>Gazebo/Red</material>
      <mu1>1000.0</mu1>
      <mu2>1000.0</mu2>
      <kp>10000000.0</kp>
      <kd>1.0</kd>
      <selfCollide>true</selfCollide>
    </gazebo>
  </xacro:macro>

  <!-- Tabletop -->
  <link name="table_top_link">
    <inertial>
      <mass value="1.0" />
      <origin xyz="${table_x} ${table_y} ${table_z + table_height - table_top_thickness / 2}" />
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
    </inertial>
    <visual>
      <origin xyz="${table_x} ${table_y} ${table_z + table_height - table_top_thickness / 2}" />
      <geometry>
        <box size="${table_width} ${table_depth} ${table_top_thickness}" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="${table_x} ${table_y} ${table_z + table_height - table_top_thickness / 2}" />
      <geometry>
        <box size="${table_width} ${table_depth} ${table_top_thickness}" />
      </geometry>
    </collision>
  </link>

  <gazebo reference="table_top_link">
    <material>Gazebo/LightWood</material>
    <mu1>50.0</mu1>
    <mu2>50.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Generate 4 legs using macro -->
  <xacro:table_leg name="leg1" pos_x="${table_x + table_width / 2}" pos_y="${table_y + table_depth / 2}" />
  <xacro:table_leg name="leg2" pos_x="${table_x - table_width / 2}" pos_y="${table_y + table_depth / 2}" />
  <xacro:table_leg name="leg3" pos_x="${table_x + table_width / 2}" pos_y="${table_y - table_depth / 2}" />
  <xacro:table_leg name="leg4" pos_x="${table_x - table_width / 2}" pos_y="${table_y - table_depth / 2}" />

  <!-- Define canonical body -->
  <gazebo>
    <canonicalBody>table_top_link</canonicalBody>
  </gazebo>

</robot>
